<Window x:Class="QualityControlSystem.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QualityControlSystem.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Quality Control System" 
        Height="768" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель навигации -->
        <Border Grid.Column="0" Background="#2D2D2D">
            <StackPanel>
                <TextBlock Text="АСККСKK" 
                           Foreground="White" 
                           FontSize="18" 
                           FontWeight="Bold"
                           Margin="16,24,16,32"/>
                <ItemsControl ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Header}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MenuButtonStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Основной контент -->
        <ContentControl x:Name="MainContent" Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Background="#F5F5F5"/>
    </Grid>
</Window>