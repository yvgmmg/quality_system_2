<Window x:Class="QualityControlSystem.WPF.Views.RegulatoryInformationEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="НСИ"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   x:Name="TitleText"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Название" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Тип / источник" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TypeComboBox" Margin="0,0,0,10" SelectedValuePath="Tag">
            <ComboBoxItem Content="Оборудование" Tag="equipment"/>
            <ComboBoxItem Content="Каркас" Tag="frame"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Минимальное значение" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="MinValueTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Максимальное значение" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="MaxValueTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Единица измерения" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="5" Grid.Column="1"
                  x:Name="MeasurementComboBox"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Value"
                  Margin="0,0,0,10"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Дата начала" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="6" Grid.Column="1" x:Name="StartDatePicker" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Дата окончания" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="7" Grid.Column="1" x:Name="EndDatePicker" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Описание" Margin="0,0,12,10" VerticalAlignment="Top"/>
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="DescriptionTextBox" Margin="0,0,0,10" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="100" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
