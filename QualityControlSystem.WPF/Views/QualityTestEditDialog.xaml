<Window x:Class="QualityControlSystem.WPF.Views.QualityTestEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тест контроля"
        Width="820"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   x:Name="TitleText"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Название" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="DescriptionTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Модель каркаса" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="FrameComboBox" Margin="0,0,0,10"
                  DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Шаблоны" Margin="0,0,12,10" VerticalAlignment="Top"/>
        <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="260"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Поиск" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TemplateSearchTextBox" Width="190" Margin="0,0,12,0" TextChanged="TemplateFilter_Changed"/>
                    <TextBlock Text="Сторона" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="TemplateSideFilterComboBox" Width="130" SelectionChanged="TemplateFilter_Changed"/>
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="1"
                      x:Name="TemplatesDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Выбрать" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTemplateColumn Header="Фото" Width="110" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="86" Height="64" Background="#EEEEEE" BorderBrush="#DDDDDD" BorderThickness="1" Margin="4">
                                    <Image Source="{Binding Template.ImagePreview}" Stretch="Uniform"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Имя" Binding="{Binding Template.Name}" Width="170" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Сторона" Binding="{Binding Template.Side}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Путь" Binding="{Binding Template.ImagePath}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="100" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
