<UserControl x:Class="QualityControlSystem.WPF.Views.EquipmentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Command="{Binding AddEquipmentCommand}" Content="Добавить" Width="80" Margin="5"/>
            <Button Command="{Binding EditEquipmentCommand}" Content="Редактировать" Width="100" Margin="5"/>
            <Button Command="{Binding DeleteEquipmentCommand}" Content="Удалить" Width="80" Margin="5"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Equipment}"
                  SelectedItem="{Binding SelectedEquipment}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Серийный номер" Binding="{Binding SerialNumber}" Width="130"/>
                <DataGridTextColumn Header="ОКОФ" Binding="{Binding OkofCode}" Width="130"/>
                <DataGridTextColumn Header="Инвентарный номер" Binding="{Binding InventoryNumber}" Width="150"/>
                <DataGridTextColumn Header="Цех" Binding="{Binding WorkshopName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="5" Foreground="Red"/>
    </Grid>
</UserControl>
