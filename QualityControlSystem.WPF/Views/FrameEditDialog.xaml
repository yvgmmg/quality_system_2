<Window x:Class="QualityControlSystem.WPF.Views.FrameEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каркас"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   x:Name="TitleText"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Название" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Материал" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  x:Name="MaterialComboBox"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"
                  Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Цех" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1"
                  x:Name="WorkshopComboBox"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"
                  Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Вес" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="WeightTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Длина" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="LengthTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Ширина" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="WidthTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Высота" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="HeightTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Изображение" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <Grid Grid.Row="8" Grid.Column="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="ImagePathTextBox" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Обзор" Width="70" Click="BrowseButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="100" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
