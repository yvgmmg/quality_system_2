<Window x:Class="QualityControlSystem.WPF.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   x:Name="TitleText"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Фамилия" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SurnameTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Имя" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="NameTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Отчество" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="PatronTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Табельный номер" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="PersonnelNumberTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Роль" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="RoleComboBox" Margin="0,0,0,10" SelectedValuePath="Tag">
            <ComboBoxItem Content="Администратор" Tag="Admin"/>
            <ComboBoxItem Content="Оператор" Tag="Operator"/>
            <ComboBoxItem Content="Специалист по оборудованию" Tag="EquipmentSpecialist"/>
            <ComboBoxItem Content="Контролёр качества" Tag="QualityControlOfficer"/>
        </ComboBox>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="ID цеха" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="WorkshopIdTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="7" Grid.Column="0" x:Name="PasswordLabel" Text="Пароль" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="7" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="8" Grid.Column="1"
                   x:Name="PasswordHintText"
                   Foreground="#666666"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="100" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
